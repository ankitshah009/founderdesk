# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_SECRET=                       # required in production: signs review/order links (openssl rand -hex 32)
DESK_TOKEN=                       # required in production: operator desk sign-in
MCP_API_KEY=                      # bearer key for /api/mcp
CRON_SECRET=                      # Vercel cron auth for /api/cron/tick

# ── Neon (omit for local embedded Postgres via PGlite) ─────────────────────────
DATABASE_URL=

# ── Stripe Checkout ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=                  # optional; otherwise a $9 inline price is used
OFFER_AMOUNT_CENTS=900

# ── AgentMail (one inbox for the business) ────────────────────────────────────
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=               # e.g. desk@agentmail.to — created by `pnpm setup:agentmail`
AGENTMAIL_WEBHOOK_SECRET=         # whsec_… from the webhook

# ── Naïve Managed Agents (researcher, writer, reviewer) ──────────────────────
NAIVE_API_KEY=
NAIVE_MODEL=vetta/auto
NAIVE_SESSION_BUDGET_MICRO_USD=700000

# ── Monid (choose real endpoints with `pnpm setup:monid`) ─────────────────────
MONID_API_KEY=
MONID_SEARCH_PROVIDER=
MONID_SEARCH_ENDPOINT=
MONID_SEARCH_INPUT={"query":"{{query}}","numResults":5}
MONID_FETCH_PROVIDER=
MONID_FETCH_ENDPOINT=
MONID_FETCH_INPUT={"url":"{{url}}"}
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_FETCHES=8

# ── Mobile Run (real-phone check of the live article) ─────────────────────────
MOBILERUN_API_KEY=
MOBILERUN_DEVICE_ID=

# ── Optional announcement destinations ────────────────────────────────────────
X_USER_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
